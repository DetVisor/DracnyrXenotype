	  <drawSize>1.1</drawSize>
    </graphicData>
	<altitudeLayer>MoteOverhead</altitudeLayer>
    <apparel>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/CamoCloak/CamoCloakHood_Drafted</wornGraphicPath>
