<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ApparelNoQualityBase">
    <defName>LTS_Apparel_CamoCloak</defName>
    <label>opticamo cloak</label>
    <description>an optical camouflage cloak. It makes the user stealthier and harder to shoot. The illusion is only effective at range.</description>
    <!--<possessionCount>1</possessionCount>-->
	<techLevel>Ultra</techLevel>
	<recipeMaker IsNull="True" />
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/CamoCloak/CamoCloak</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <shaderType>CutoutComplex</shaderType>
      <drawSize>1.1</drawSize>
    </graphicData>
	<thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
	<tradeTags>
	  <li>HiTechArmor</li>
	</tradeTags>
	<costList>
      <ComponentSpacer>4</ComponentSpacer>
      <Hyperweave>100</Hyperweave>
      <Uranium>20</Uranium>
    </costList>
	<smeltable>false</smeltable>
    <statBases>
      <Mass>3</Mass>
      <Flammability>0.4</Flammability>
	  <Insulation_Cold>10</Insulation_Cold>
      <Insulation_Heat>6</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
	<equippedStatOffsets>
	  <LTS_AccuracyAgainstMeOffset>-0.2</LTS_AccuracyAgainstMeOffset>
	  <HuntingStealth>0.5</HuntingStealth>
    </equippedStatOffsets>
    <apparel>
	  <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/CamoCloak/CamoCloak</wornGraphicPath>
	  <useWornGraphicMask>true</useWornGraphicMask>
      <bodyPartGroups>
        <!--<li>UpperHead</li>
		<li>FullHead</li>-->
		<li>Neck</li>
		<li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
      <shellRenderedBehindHead>true</shellRenderedBehindHead>
      <layers>
	    <li>LTS_FullCloak</li>
      </layers>
      <drawData>
        <dataNorth>
          <layer>100</layer>
        </dataNorth>
        <dataEast>
          <layer>100</layer>
        </dataEast>
		<dataWest>
          <layer>100</layer>
        </dataWest>
      </drawData>
      <tags>
		<li>DracnyrSpacerMilitary</li>
      </tags>
    </apparel>
	<allowedArchonexusCount>1</allowedArchonexusCount>
	<generateAllowChance>0</generateAllowChance>
	<modExtensions>
      <li Class="LTS_DracnirGenes.DracnyrExtension">
        <hasHoodGraphic>True</hasHoodGraphic>
		<hasDraftedGraphic>True</hasDraftedGraphic>
		<cloakWhenDrafted>True</cloakWhenDrafted>
      </li>
    </modExtensions>
	<comps>
		<li Class="CompProperties_Biocodable"/>
	</comps>
	<colorGenerator Class="ColorGenerator_Options">
	  <options>
		<li>
		  <weight>10</weight>
		  <only>(0.9,0.9,0.9)</only>
		</li>
		<li>
		  <weight>10</weight>
		  <only>(0.33,0.33,0.33)</only>
		</li>
		<li>
		  <weight>10</weight>
		  <only>(0.65,0.65,0.65)</only>
		</li>
		<li>
		  <weight>6</weight>
		  <min>(0.3,0.3,0.3)</min>
		  <max>(0.5,0.5,0.5)</max>
		</li>
	  </options>
	</colorGenerator>
	<thingSetMakerTags>
	  <li>RewardStandard</li>
	</thingSetMakerTags>
  </ThingDef>
  
  <ThingDef>
    <defName>LTS_Apparel_CamoCloak_Drafted</defName>
	<thingClass>Apparel</thingClass>
    <label>If you are seeing this, this is a bug</label>
