    </graphicData>
	<altitudeLayer>MoteOverhead</altitudeLayer>
    <apparel>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/CamoCloak/CamoCloak_Drafted</wornGraphicPath>
	  <useWornGraphicMask>true</useWornGraphicMask>
      <layers>
        <li>EyeCover</li>
      </layers>
    </apparel>
  </ThingDef>
  
